# ==============================================================================
# Web-GIS Production Environment Variables
# Salin file ini menjadi .env.production di VPS: cp .env.production.example .env.production
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Mapbox Configuration (Wajib untuk render peta 3D)
# Dapatkan di https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token-here

# Standalone PostgreSQL Credentials (Internal Docker Network)
# Ganti POSTGRES_PASSWORD dengan kata sandi yang aman dan acak
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GantiDenganPasswordSuperAmanDanKuat123!
POSTGRES_DB=webgis

# Database Connection String untuk Next.js App
# Note: 'webgis-db' adalah hostname service container PostgreSQL di internal docker network
DATABASE_URL=postgresql://postgres:GantiDenganPasswordSuperAmanDanKuat123!@webgis-db:5432/webgis?sslmode=disable
POSTGRES_URL=postgresql://postgres:GantiDenganPasswordSuperAmanDanKuat123!@webgis-db:5432/webgis?sslmode=disable
DATABASE_SSL=false

# Standalone JWT Security (Minimal 32 karakter acak)
# Anda bisa generate via terminal VPS: openssl rand -hex 32
JWT_SECRET=c2VjdXJlLXN1cGVyLXNlY3JldC1qd3QtdG9rZW4tdmlldzM2MC1lbnRlcnByaXNlLTMyYnl0ZXM=

# Standalone Storage Engine (Penyimpanan Panorama 360 & Geometri)
STORAGE_DRIVER=local

# URL Publik Aplikasi (Untuk domain Anda)
# NEXT_PUBLIC_SITE_URL=https://domainanda.com
